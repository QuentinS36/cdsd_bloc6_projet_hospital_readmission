# Copier ce fichier en `.env` (jamais versionné) puis renseigner les valeurs.

# --- DagsHub / MLflow (API, notebooks, scripts/export_models.py) ---
DAGSHUB_OWNER=
DAGSHUB_REPO=
DAGSHUB_USER_TOKEN=
# Versions des modèles du registre (défaut : 1)
# READMISSION_MODEL_VERSION=1
# LENGTH_OF_STAY_MODEL_VERSION=1

# --- Dashboard -> API ---
API_URL=http://localhost:8000
# Optionnelle : si définie, l'API exige l'en-tête X-API-Key (même valeur des deux côtés)
API_KEY=

# --- RGPD : sel de pseudonymisation des identifiants affichés (aléatoire si vide) ---
PSEUDONYMIZATION_SALT=

# --- Sources de données (chemin local par défaut : data/hospital_readmission_dataset.csv) ---
# DATA_URL_HISTO=
# DATA_URL_PLANNING=
